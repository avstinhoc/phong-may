{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/timetable.js": {
      "maxDuration": 60
    },
    "api/help.js": {
      "maxDuration": 60
    },
    "api/help-actions.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/register",
      "destination": "/index.html"
    },
    {
      "source": "/student",
      "destination": "/index.html"
    },
    {
      "source": "/school",
      "destination": "/index.html"
    },
    {
      "source": "/school/grade/:grade",
      "destination": "/index.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/index.html"
    }
  ]
}
