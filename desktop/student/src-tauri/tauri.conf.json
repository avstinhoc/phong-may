{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QLPM Student",
  "version": "0.1.0",
  "identifier": "vn.qlpm.student",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev -- --host 127.0.0.1",
    "devUrl": "http://localhost:5173/student-desktop.html",
    "beforeBuildCommand": "npm --prefix ../.. run build -- --mode desktop",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QLPM Student",
        "url": "student-desktop.html",
        "width": 1140,
        "height": 750,
        "minWidth": 840,
        "minHeight": 590,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
